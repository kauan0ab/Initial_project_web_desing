<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="../css/for.css" />
    <title>Spawn Point</title>
  </head>

  <body>
   
    <header class="cabecalho">
      <div class="cabecalho_content">
        <a href="home.html" class="marca">
          <img id="logotipo" src="../img/logo_Spwan_point.png" alt="Logo do Spawn Point" />
          <span class="nome_evento">Spawn Point</span>
        </a>
        <nav>
          <ul>
            <li><a href="/" aria-current="page">Home</a></li>
            <li><a href="/">Faq</a></li>
            <li><a href="/">O evento</a></li>
            <li><a href="calendario.html">Calendário</a></li>
            <li class="item_ingressos"><a href="ticket_buy_page.html" class="btn_ingressos">Ingressos</a></li>
          </ul>
        </nav>
      </div>
    </header>

    
    <main>
    
      <input type="checkbox" id="trocar-tela" class="checkbox-trocar" />

      <div class="cartao">
        
        
          <div class="campo">
            <label for="email">E-mail</label>
            <input type="email" id="email" placeholder="Digite seu e-mail" required />
          </div>

          <div class="campo">
            <label for="senha">Senha</label>
            <input type="password" id="senha" placeholder="Digite sua senha" required />
          </div>

          <a href="#" class="esqueceu">Esqueceu a senha?</a>

          <button type="submit" class="btn-entrar">Entrar</button>

          <label for="trocar-tela" class="btn-criar">Criar conta</label>

        
        </form> 
        
        <form id="form-cadastro">
          <div class="campo">
            <label for="nova-senha">Criar senha</label>
            <input type="password" id="nova-senha" placeholder="Digite uma senha" required />
          </div>

          <div class="campo">
            <label for="confirma-senha">Confirmar senha</label>
            <input type="password" id="confirma-senha" placeholder="Confirme a senha" required />
          </div>

          <div class="regras">
            <p class="regra-item">✕ Ao menos 8 caracteres</p>
            <p class="regra-item">✕ Ao menos 1 letra minúscula</p>
            <p class="regra-item">✕ Ao menos 1 letra maiúscula</p>
            <p class="regra-item">✕ Ao menos 1 número</p>
            <p class="regra-item">✕ Ao menos 1 caractere especial</p>
          </div>

          <div class="opcoes">
            <p>Aceito receber notificações e ofertas via:</p>
            <label><input type="checkbox" /> E-mail</label>
            <label><input type="checkbox" /> SMS</label>
            <label><input type="checkbox" /> WhatsApp</label>
          </div>

          <div class="opcoes">
            <label>
              <input type="checkbox" required />
              Eu li e concordo com a <a href="#">Política de Privacidade</a>
            </label>
          </div>

          <button type="submit" class="btn-entrar">Cadastrar</button>

          <label for="trocar-tela" class="btn-criar">Voltar</label>
        </form>

      </div>
    </main>

  
    <footer class="rodape">
      <div class="footer_AKG_side">
        <img src="../img/akg_organizaora.png" alt="Logotipo da AKG" id="logo_akg" />
        <p>Organizadoria AKG</p>
        <p>&copy; 2026 todos os direitos reservados</p>
      </div>
      <div class="footer_elements_event_side">
        <a href="#">Central de ajuda</a>
        <a href="#">Política de privacidade</a>
      </div>
    </footer>
  </body>
</html>